{
    "name": "echo-fusion/databasemanager",
    "description": "A small, replaceable database layer for EchoFusion: a PDO connection, a query builder, named connections and an optional Doctrine DBAL adapter, all behind one contract.",
    "keywords": [
        "database",
        "pdo",
        "query-builder",
        "dbal",
        "echofusion"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/echo-fusion/databasemanager",
    "authors": [
        {
            "name": "Amir Shadanfar",
            "email": "a.shadanfar.it@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/echo-fusion/databasemanager/issues",
        "source": "https://github.com/echo-fusion/databasemanager"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "ext-pdo": "*",
        "echo-fusion/contracts": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "vimeo/psalm": "^5.26",
        "friendsofphp/php-cs-fixer": "^3.64",
        "echo-fusion/codestandard": "^1.0",
        "doctrine/dbal": "^4.0"
    },
    "suggest": {
        "doctrine/dbal": "Required to use the DoctrineConnection adapter (^4.0)."
    },
    "autoload": {
        "psr-4": {
            "EchoFusion\\DatabaseManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EchoFusion\\DatabaseManager\\Tests\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": [
            "@cs-check",
            "@analyze",
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit",
        "test:coverage:text": "vendor/bin/phpunit --coverage-text",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "analyze": "psalm --show-info=false --no-cache --no-progress"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
